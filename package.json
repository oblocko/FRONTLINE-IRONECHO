{
  "name": "frontline-iron-echo",
  "version": "0.2.0",
  "private": true,
  "description": "FRONTLINE — IRON ECHO: single-player modern military FPS campaign (Three.js / WebGL)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node tools/check_vendor.mjs && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vite build && node tests/smoke.mjs",
    "test:mission": "vite build && node tests/mission01_playthrough.mjs",
    "test:ai": "vite build && node tests/ai_combat.mjs",
    "test:flow": "vite build && node tests/flow.mjs",
    "screens": "vite build && node tests/screens.mjs",
    "test:m02": "vite build && node tests/mission02_playthrough.mjs",
    "test:m03": "vite build && node tests/mission03_playthrough.mjs",
    "test:m04": "vite build && node tests/mission04_playthrough.mjs",
    "test:sweep": "vite build && node tests/sweep.mjs",
    "compose:menu": "python3 tools/compose_menu_theme.py menu_theme.wav && ffmpeg -y -i menu_theme.wav -codec:a libmp3lame -b:a 192k assets/audio/menu_theme.mp3",
    "test:m05": "vite build && node tests/mission05_branches.mjs",
    "check:vendor": "node tools/check_vendor.mjs",
    "test:m06": "vite build && node tests/mission06_branches.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "vite": "8.3.8"
  }
}
